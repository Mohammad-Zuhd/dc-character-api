
<#import "layout.ftlh" as l>

<@l.page title="Character Not Found">

    <div class="text-center py-5">

        <h1 class="display-4 mb-3">
            Character Not Found
        </h1>

        <p class="lead">
            The character you are looking for
            does not exist.
        </p>

        <p class="text-muted">
            It may have been deleted or the URL
            may be incorrect.
        </p>

        <a href="/" class="btn btn-primary mt-3">
            Back to Gallery
        </a>

    </div>

</@l.page>
